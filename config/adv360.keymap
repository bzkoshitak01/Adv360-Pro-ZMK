#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        t_left_mac: t_left_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "T_LEFT_MAC";
            bindings = <&kp T>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        n_right_mac: n_right_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "N_RIGHT_MAC";
            bindings = <&kp N>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        s_up_mac: s_up_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "S_UP_MAC";
            bindings = <&kp S>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        h_down_mac: h_down_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "H_DOWN_MAC";
            bindings = <&kp H>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };
    };

    macros {
        hyper: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp LEFT_ALT &kp LEFT_CONTROL>;
            label = "NEW_MACRO";
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PARENTHESES";
        };

        braces: curly_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "CURLY_BRACES";
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BRACKETS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        onishi_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1          &kp N2        &kp N3          &kp N4           &kp N5         &sl 3                                                                                                            &mo 2              &kp N6  &kp N7                &kp N8                 &kp N9     &kp N0       &kp BSLH
&kp ESCAPE      &kp Q           &kp L         &kp U           &kp COMMA        &kp PERIOD     &kp EXCLAMATION                                                                                                  &kp DOUBLE_QUOTES  &kp F   &kp W                 &kp R                  &kp Y      &kp P        &kp SQT
&kp TAB         &kp E           &kp I         &kp A           &kp O            &kp MINUS      &kp QUESTION     &mt LCTRL INT_MUHENKAN  &kp BACKSPACE      &kp GRAVE                      &mt RCTRL INT_HENKAN  &kp COLON          &kp K   &t_left_mac           &n_right_mac           &s_up_mac  &h_down_mac  &kp BACKSPACE
&kp LEFT_ALT    &kp Z           &kp X         &kp C           &kp V            &kp SEMICOLON                                           &kp ENTER          &kp SLASH                                                               &kp G   &kp D                 &kp M                  &kp J      &kp B        &kp RIGHT_COMMAND
&kp LEFT_SHIFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW                 &kp SPACE        &kp LEFT_COMMAND        &mo 1              &kp RS(RA(RC(RIGHT_COMMAND)))  &kp RIGHT_SHIFT       &kp ENTER                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT   &kp RBKT     &kp RIGHT_ALT
            >;
        };

        onishi_reverse_command_layer {
            display-name = "Base";
            bindings = <
&none  &none      &none      &none      &none      &none      &none                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RG(P)  &kp RG(Y)  &kp RG(R)  &kp RG(W)  &kp RG(F)  &none                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RG(H)  &kp RG(S)  &kp RG(N)  &kp RG(T)  &kp RG(K)  &none  &none  &none       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RG(B)  &kp RG(J)  &kp RG(M)  &kp RG(D)  &kp RG(G)                &none       &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&none  &none      &none      &none      &none                 &none  &none  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none                                        &none   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &none
&trans  &trans  &trans  &trans  &trans  &trans  &kp F11                                      &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp F12  &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                   &trans      &trans                  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans   &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        qwerty_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL                     &kp N1          &kp N2        &kp N3          &kp N4           &kp N5  &mo 3                                                                         &mo 2              &kp N6  &kp N7                &kp N8                 &kp N9    &kp N0    &kp BSLH
&kp LS(LA(LC(LEFT_COMMAND)))  &kp Q           &kp W         &kp E           &kp R            &kp T   &kp EXCL                                                                      &kp DOUBLE_QUOTES  &kp Y   &kp U                 &kp I                  &kp O     &kp P     &kp SQT
&kp TAB                       &kp A           &kp S         &kp D           &kp F            &kp G   &kp QUESTION  &kp LCTRL         &kp ESCAPE      &kp PLUS   &kp RCTRL          &kp COLON          &kp H   &kp J                 &kp K                  &kp L     &kp SEMI  &kp BACKSPACE
&kp LSHFT                     &kp Z           &kp X         &kp C           &kp V            &kp B                                   &none           &kp MINUS                                        &kp N   &kp M                 &kp COMMA              &kp DOT   &kp FSLH  &kp RSHFT
&kp LEFT_ALT                  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW          &kp SPACE     &kp LEFT_COMMAND  &none           &kp GRAVE  &kp RIGHT_COMMAND  &kp ENTER                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT  &kp RBKT  &kp RIGHT_ALT
            >;
        };

        onishi_layer_old {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1          &kp N2        &kp N3          &kp N4           &kp N5         &sl 3                                                                                                 &mo 2              &kp N6  &kp N7                &kp N8                 &kp N9    &kp N0    &kp BSLH
&kp ESCAPE      &kp Q           &kp L         &kp U           &kp COMMA        &kp PERIOD     &kp EXCLAMATION                                                                                       &kp DOUBLE_QUOTES  &kp F   &kp W                 &kp R                  &kp Y     &kp P     &kp SQT
&kp TAB         &kp E           &kp I         &kp A           &kp O            &kp MINUS      &kp QUESTION     &kp LCTRL         &kp BACKSPACE      &kp GRAVE                      &kp RCTRL        &kp COLON          &kp K   &kp T                 &kp N                  &kp S     &kp H     &kp BACKSPACE
&kp LEFT_ALT    &kp Z           &kp X         &kp C           &kp V            &kp SEMICOLON                                     &kp ENTER          &kp SLASH                                                          &kp G   &kp D                 &kp M                  &kp J     &kp B     &kp RIGHT_COMMAND
&kp LEFT_SHIFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW                 &kp SPACE        &kp LEFT_COMMAND  &mo 1              &kp RS(RA(RC(RIGHT_COMMAND)))  &kp RIGHT_SHIFT  &kp ENTER                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT  &kp RBKT  &kp RIGHT_ALT
            >;
        };
    };
};
