#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        t_left_mac_cmd: t_left_mac_cmd {
            compatible = "zmk,behavior-mod-morph";
            label = "T_LEFT_MAC_CMD";
            bindings = <&kp T>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        n_right_mac_cmd: n_right_mac_cmd {
            compatible = "zmk,behavior-mod-morph";
            label = "N_RIGHT_MAC_CMD";
            bindings = <&kp N>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        s_up_mac_cmd: s_up_mac_cmd {
            compatible = "zmk,behavior-mod-morph";
            label = "S_UP_MAC_CMD";
            bindings = <&kp S>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        h_down_mac_cmd: h_down_mac_cmd {
            compatible = "zmk,behavior-mod-morph";
            label = "H_DOWN_MAC_CMD";
            bindings = <&kp H>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        t_left_win_ctl: t_left_win_ctl {
            compatible = "zmk,behavior-mod-morph";
            label = "T_LEFT_WIN_CTL";
            bindings = <&kp T>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        n_right_win_ctl: n_right_win_ctl {
            compatible = "zmk,behavior-mod-morph";
            label = "N_RIGHT_WIN_CTL";
            bindings = <&kp N>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        s_up_win_ctl: s_up_win_ctl {
            compatible = "zmk,behavior-mod-morph";
            label = "S_UP_WIN_CTL";
            bindings = <&kp S>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        h_down_win_ctl: h_down_win_ctl {
            compatible = "zmk,behavior-mod-morph";
            label = "H_DOWN_WIN_CTL";
            bindings = <&kp H>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        fn_os: fn_os {
            compatible = "zmk,behavior-mod-morph";
            label = "FN_OS";
            bindings = <&sl 5>, <&tog 2>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };

        new_hold_tap: new_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_HOLD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
        };
    };

    macros {
        hyper: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp LEFT_ALT &kp LEFT_CONTROL>;
            label = "NEW_MACRO";
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PARENTHESES";
        };

        braces: curly_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "CURLY_BRACES";
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BRACKETS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1          &kp N2        &kp N3          &kp N4           &kp N5         &fn_os                                                                                                      &mo 4              &kp N6  &kp N7                &kp N8                 &kp N9    &kp N0    &kp BSLH
&kp ESCAPE      &kp L           &kp COMMA     &kp U           &kp PERIOD       &kp Q          &kp EXCLAMATION                                                                                             &kp DOUBLE_QUOTES  &kp F   &kp G                 &kp R                  &kp Y     &kp P     &kp SQT
&kp TAB         &kp E           &kp I         &kp A           &kp O            &kp MINUS      &kp QUESTION           &kp LCTRL         &kp BACKSPACE      &kp GRAVE                      &kp RCTRL        &kp COLON          &kp K   &kp T                 &kp N                  &kp S     &kp H     &kp BACKSPACE
&kp LEFT_ALT    &kp Z           &kp X         &kp C           &kp V            &kp SEMICOLON                                           &kp ENTER          &kp SLASH                                                          &kp W   &kp D                 &kp M                  &kp J     &kp B     &kp RIGHT_ALT
&kp LEFT_SHIFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW                 &new_hold_tap 1 SPACE  &kp LEFT_COMMAND  &mo 1              &kp RS(RA(RC(RIGHT_COMMAND)))  &kp RIGHT_SHIFT  &kp ENTER                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT  &kp RBKT  &kp RIGHT_COMMAND
            >;
        };

        mac_reverse {
            display-name = "Base";
            bindings = <
&none  &none      &none      &none      &none      &none      &none                                     &trans  &trans  &trans          &trans           &trans        &trans          &trans
&none  &kp RG(P)  &kp RG(Y)  &kp RG(R)  &kp RG(G)  &kp RG(F)  &none                                     &trans  &trans  &trans          &trans           &trans        &trans          &trans
&none  &kp RG(H)  &kp RG(S)  &kp RG(N)  &kp RG(T)  &kp RG(K)  &none  &none  &none       &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &trans
&none  &kp RG(B)  &kp RG(J)  &kp RG(M)  &kp RG(D)  &kp RG(W)                &none       &trans                  &trans  &trans          &trans           &trans        &trans          &trans
&none  &none      &none      &none      &none                 &none  &none  &trans      &trans  &trans  &trans          &trans          &trans           &trans        &trans          &trans
            >;
        };

        win {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1          &kp N2        &kp N3          &kp N4           &kp N5         &fn_os                                                                                                                  &mo 4              &kp N6  &kp N7                &kp N8                 &kp N9    &kp N0    &kp BSLH
&kp ESCAPE      &kp L           &kp COMMA     &kp U           &kp PERIOD       &kp Q          &kp EXCLAMATION                                                                                                         &kp DOUBLE_QUOTES  &kp F   &kp G                 &kp R                  &kp Y     &kp P     &kp SQT
&kp TAB         &kp E           &kp I         &kp A           &kp O            &kp MINUS      &kp QUESTION     &kp LEFT_WIN              &kp BACKSPACE      &kp GRAVE                      &kp RIGHT_WIN              &kp COLON          &kp K   &kp T                 &kp N                  &kp S     &kp H     &kp BACKSPACE
&kp LEFT_ALT    &kp Z           &kp X         &kp C           &kp V            &kp SEMICOLON                                             &kp ENTER          &kp SLASH                                                                    &kp W   &kp D                 &kp M                  &kp J     &kp B     &kp RIGHT_ALT
&kp LEFT_SHIFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW                 &kp SPACE        &mt LEFT_CONTROL PAGE_UP  &mo 3              &kp RS(RA(RC(RIGHT_COMMAND)))  &mt RIGHT_SHIFT PAGE_DOWN  &kp ENTER                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT  &kp RBKT  &kp RIGHT_CONTROL
            >;
        };

        win_reverse {
            display-name = "Base";
            bindings = <
&none  &none      &none      &none      &none      &none      &none                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RC(P)  &kp RC(Y)  &kp RC(R)  &kp RC(G)  &kp RC(F)  &none                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RC(H)  &kp RC(S)  &kp RC(N)  &kp RC(T)  &kp RC(K)  &none  &none  &none       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &kp RC(B)  &kp RC(J)  &kp RC(M)  &kp RC(D)  &kp RC(W)                &none       &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&none  &none      &none      &none      &none                 &none  &none  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none                                        &none   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &none
&trans  &trans  &trans  &trans  &trans  &trans  &kp F11                                      &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp F12  &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                   &trans      &trans                  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans   &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };
    };
};
